{
  "schema_version": "1.0",
  "purpose": "MVP/W1执行期间备选方案量化触发阈值",
  "description": "每个触发规则包含: 条件(阈值) -> 动作(备选方案) -> 责任人 -> 依据",
  "rules": [
    {
      "id": "R01",
      "phase": "P1",
      "risk": "UCSD数据时间对齐失败",
      "metric": "gap_fraction",
      "metric_description": "缺失时间步数/期望数据点数",
      "threshold": 0.0001,
      "threshold_description": "gap_fraction > 0.01%",
      "action": "启动QC填补层: 线性插值+缺失标记; 如gap>1%则回退数据冻结",
      "owner": "数据工程师",
      "evidence": "frozen_parameters_v2.2.json acceptance.power_residual",
      "severity": "high"
    },
    {
      "id": "R02",
      "phase": "P1",
      "risk": "BLAST-Lite运行报错(trapz/trapezoid)",
      "metric": "import_error",
      "threshold": 1,
      "threshold_description": "np.trapz不存在或BLAST-Lite import失败",
      "action": "添加兼容层: np.trapz = np.trapezoid; 或安装numpy<2.0",
      "owner": "数据工程师",
      "evidence": "requirements.txt BLAST-Lite兼容层",
      "severity": "medium"
    },
    {
      "id": "R03",
      "phase": "P2",
      "risk": "BAT健康映射R²不足",
      "metric": "r2_fit",
      "threshold": 0.8,
      "threshold_description": "R² < 0.8",
      "action": "检查HPPC数据缺失时点; 补充A123 BOL参考点; 调整拟合阶数",
      "owner": "建模工程师",
      "evidence": "frozen_parameters_v2.2.json acceptance.independent_degradation.R2_min",
      "severity": "high"
    },
    {
      "id": "R04",
      "phase": "P2",
      "risk": "FC/EL规模迁移参数偏差过大",
      "metric": "system_efficiency_deviation",
      "threshold": 0.15,
      "threshold_description": "系统效率偏离区间[0.33,0.37](FC)或[0.60,0.67](EL)超过15%",
      "action": "扩大辅机效率区间报告; 启动端点鲁棒性测试; 在论文Limitation中声明",
      "owner": "建模工程师",
      "evidence": "mvp_bol_parameters.json scale_migration.system_efficiency_range",
      "severity": "medium"
    },
    {
      "id": "R05",
      "phase": "P3",
      "risk": "gamma路径(FC/EL→BAT)退化模型未完成",
      "metric": "gamma_path_status",
      "threshold": 0,
      "threshold_description": "gamma路径退化率=0或NaN",
      "action": "gamma路径先置零(零路径处理); P4阶段补全; 不影响alpha1/beta1路径",
      "owner": "建模工程师",
      "evidence": "frozen_parameters_v2.2.json coupling.default_zero_paths",
      "severity": "low"
    },
    {
      "id": "R06",
      "phase": "P3",
      "risk": "功率守恒残差超标",
      "metric": "power_residual_fraction",
      "threshold": 1e-6,
      "threshold_description": "残差/额定功率 > 1e-6",
      "action": "检查EMS命令逻辑; 检查辅机功率计算; 回退P3阶段",
      "owner": "建模工程师",
      "evidence": "frozen_parameters_v2.2.json acceptance.power_residual_fraction_of_rated_power_max",
      "severity": "high"
    },
    {
      "id": "R07",
      "phase": "P4",
      "risk": "联盟OFF→g_i(0)替换逻辑错误",
      "metric": "coalition_off_test_pass_rate",
      "threshold": 1,
      "threshold_description": "8个TC-OFF用例中任一未通过(除M4 AE<0的物理合理情况)",
      "action": "检查g_i(0)替换代码; 验证v(空集)=BOL损伤; 逐组排查OFF逻辑",
      "owner": "方法工程师",
      "evidence": "联盟OFF测试8个TC-OFF用例通过标准",
      "severity": "high"
    },
    {
      "id": "R08",
      "phase": "P4",
      "risk": "M4(库存控制)AE异常(非物理合理的NaN/Inf)",
      "metric": "m4_ae_anomaly",
      "threshold": 10,
      "threshold_description": "|AE(I)| > 10 × max(|AE(C)|, |AE(E)|, |AE(P)|) 或 AE(I)=NaN/Inf",
      "action": "标记为代码bug(非物理合理); 检查EMS策略OFF逻辑; 检查损伤累积模型",
      "owner": "方法工程师",
      "evidence": "核验3结论: M4 AE<=0物理合理, 但|AE|>10倍为异常",
      "severity": "high",
      "note": "AE(I)<=0且|AE|<=10倍为物理合理(EMS保护机制), 不触发此规则"
    },
    {
      "id": "R09",
      "phase": "P4",
      "risk": "TE分母保护触发率过高",
      "metric": "te_na_fraction",
      "threshold": 0.5,
      "threshold_description": "TE=NA的比例 > 50%",
      "action": "检查BOL运行损伤是否过小(ΔD_BOL < 1e-4); 考虑扩大仿真窗口或增加退化强度",
      "owner": "方法工程师",
      "evidence": "产出物文档: TE分母保护(ΔD<1e-4时TE=NA)",
      "severity": "medium"
    },
    {
      "id": "R10",
      "phase": "P5",
      "risk": "N_eff=0(无有效配置)",
      "metric": "n_eff",
      "threshold": 0,
      "threshold_description": "N_eff=0(所有配置的AE均不满足稀疏激活准则)",
      "action": "启动应力测试场景(D=0.90+C4配置+低氢储备); 重构零路径学术价值",
      "owner": "方法工程师",
      "evidence": "frozen_parameters_v2.2.json coupling + 产出物文档N_eff=0备选",
      "severity": "medium"
    },
    {
      "id": "R11",
      "phase": "P5",
      "risk": "Bootstrap置信区间不稳定",
      "metric": "bootstrap_same_sign_fraction",
      "threshold": 0.9,
      "threshold_description": "Bootstrap同号比例 < 90%",
      "action": "增加Bootstrap次数(B=2000或5000); 检查AE值分布; 考虑剔除异常配置",
      "owner": "方法工程师",
      "evidence": "产出物文档: 稀疏激活准则Bootstrap同号>=90%",
      "severity": "medium"
    },
    {
      "id": "R12",
      "phase": "P6",
      "risk": "年度外推假设违反",
      "metric": "extrapolation_assumption_violation",
      "threshold": 1,
      "threshold_description": "5项外推假设中任一被违反",
      "action": "在论文Limitation中声明; 扩大不确定性传播带; 考虑非线性外推模型",
      "owner": "方法工程师",
      "evidence": "产出物六风险缓解: 5项外推假设清单",
      "severity": "medium",
      "assumptions": [
        "退化速率在年度尺度近似恒定",
        "EMS策略在年度尺度不发生结构性变化",
        "气候年际变异性在3年数据范围内可代表",
        "设备替换后容量和状态连续",
        "辅机效率退化速率与主设备一致"
      ]
    },
    {
      "id": "R13",
      "phase": "P6",
      "risk": "计算量超出预算(5.1M步)",
      "metric": "total_compute_steps",
      "threshold": 6000000,
      "threshold_description": "实际计算步数 > 6M(预算5.1M的118%)",
      "action": "减少V3b LHS采样数(100→50); 减少V4配置数(6→4); 启用numba JIT加速",
      "owner": "项目经理",
      "evidence": "产出物文档: V1(336+72)+V2+V3a/b(800)+V4(84)≈5.1M步",
      "severity": "low"
    },
    {
      "id": "R14",
      "phase": "全程",
      "risk": "MVP仿真性能不达标",
      "metric": "sim_p95_sec",
      "threshold": 15,
      "threshold_description": "7天仿真P95耗时 > 15s",
      "action": "启用numba JIT加速; 减少中间变量; 优化联盟遍历; 使用numpy向量化",
      "owner": "建模工程师",
      "evidence": "产出物文档: 性能门槛中位<=10s/P95<=15s/年度<=180s",
      "severity": "medium"
    },
    {
      "id": "R15",
      "phase": "全程",
      "risk": "超可加性异向组合检查失败",
      "metric": "cross_direction_superadditivity",
      "threshold": 0,
      "threshold_description": "M1+M4(或M2+M4等异向组合)的超可加性方向与预期不一致",
      "action": "单独验证异向组合; 在论文中报告方向性差异; 不强制要求异向组合满足严格超可加",
      "owner": "方法工程师",
      "evidence": "核验3结论: M1-M3同向(严格超可加), M4异向(需单独验证)",
      "severity": "low",
      "note": "异向组合不满足严格超可加是物理合理的, 因为M4的AE方向与其他组相反"
    }
  ],
  "summary": {
    "total_rules": 15,
    "by_severity": {"high": 5, "medium": 7, "low": 3},
    "by_phase": {"P1": 2, "P2": 2, "P3": 2, "P4": 3, "P5": 2, "P6": 2, "全程": 2},
    "auto_trigger": 12,
    "manual_review": 3
  }
}
